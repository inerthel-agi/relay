{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-widgets",
  "description": "Remote overlay webviews may drag the window; they cannot invoke app commands",
  "windows": ["widget", "notification-widget", "reaction-widget"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:window:default",
    "core:window:allow-start-dragging"
  ]
}
